---
import Base from "../layouts/Base.astro";
import Paisaje from "../components/Paisaje.astro";
---
<Base titulo="Pacha" decoracion>
  <section class="bienvenida">
    <div class="foto">
      <Paisaje />
    </div>
    <div class="texto">
      <h1>Planifique su próxima siembra</h1>
      <div class="raya"></div>
      <p class="sub">Consulte la rotación de cultivos y estime el riego de su parcela, con datos de satélites de la NASA
        corregidos con estaciones del Ecuador.</p>
      <div class="pila acciones">
        <button class="btn btn-primario" type="button" id="ejemplo">Probar con un ejemplo</button>
        <a class="btn btn-borde" href="/ubicacion">Consultar mi parcela</a>
      </div>
      <ul class="sellos" aria-label="Qué usa Pacha">
        <li>🛰️ NASA POWER · GPM · MODIS</li>
        <li>🌧️ Validado con 85 estaciones del INAMHI</li>
        <li>🔊 Lee en voz alta</li>
      </ul>
    </div>
  </section>
</Base>

<script>
  import { EJEMPLO, guardar } from "../lib/estado";
  document.getElementById("ejemplo")!.addEventListener("click", () => {
    guardar({ ...EJEMPLO, mes: undefined, crop: undefined });
    location.href = "/parcela";
  });
</script>

<style>
  .bienvenida { display: grid; gap: 1.4rem; }
  .foto { margin: 0 -1rem; aspect-ratio: 16 / 10; overflow: hidden;
    clip-path: path("M0 0 H2000 V1000 H0 Z"); border-radius: 0 0 0 0; position: relative; }
  .foto::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 34px;
    background: var(--crema); clip-path: polygon(0 60%, 25% 20%, 55% 70%, 80% 30%, 100% 55%, 100% 100%, 0 100%); }
  .acciones { margin-top: 1.4rem; }
  .sellos { list-style: none; padding: 0; margin: 1.4rem 0 5rem; display: grid; gap: 0.4rem; color: var(--texto-2); font-weight: 700; font-size: 0.95rem; }
  @media (min-width: 900px) {
    .bienvenida { grid-template-columns: 1.1fr 1fr; align-items: center; gap: 3rem; min-height: 70vh; }
    .foto { margin: 0; border-radius: 28px; aspect-ratio: 4 / 3.2; box-shadow: var(--sombra); }
    .foto::after { display: none; }
    .acciones { max-width: 420px; }
  }
</style>
