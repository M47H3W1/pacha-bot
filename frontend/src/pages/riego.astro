---
import Base from "../layouts/Base.astro";
---
<Base titulo="Riego" nav="riego">
  <p class="peque" id="lugar">Su parcela</p>
  <h1>¿Cuánto regar esta semana?</h1>
  <div class="raya"></div>

  <fieldset class="grupo">
    <legend>¿Qué tiene sembrado?</legend>
    <div class="chips envolver" id="cultivos" role="group"><span class="peque">Cargando cultivos…</span></div>
  </fieldset>
  <fieldset class="grupo">
    <legend>¿Hace cuánto sembró?</legend>
    <div class="chips envolver" id="dias" role="group">
      <button class="chip" type="button" data-dias="7">Recién</button>
      <button class="chip" type="button" data-dias="30">1 mes</button>
      <button class="chip" type="button" data-dias="60">2 meses</button>
      <button class="chip" type="button" data-dias="90">3 meses</button>
      <button class="chip" type="button" data-dias="150">5 meses</button>
    </div>
  </fieldset>
  <div id="plan" aria-live="polite"></div>
</Base>

<script>
  import { guardar, leer, tieneParcela } from "../lib/estado";
  import { cargando, consultar, esc, hablar, mostrarError, num } from "../lib/api";

  let e = leer();
  if (!tieneParcela(e)) location.replace("/ubicacion");
  document.getElementById("lugar")!.textContent = `${e.nombre || "Su parcela"} · ${num(e.area_m2 || 2500)} m²`;
  const plan = document.getElementById("plan")!;
  const cajaCultivos = document.getElementById("cultivos")!;
  const cajaDias = document.getElementById("dias")!;
  const dias = e.dias || 30;
  cajaDias.querySelectorAll(".chip").forEach((b) => b.setAttribute("aria-pressed", String(Number((b as HTMLElement).dataset.dias) === dias)));

  async function listarCultivos() {
    try {
      const d = await consultar("recomendacion", { mes: e.mes });
      const lista = [...(d.cultivos || []), ...(d.otros || [])];
      if (e.crop && !lista.some((c: any) => c.id === e.crop)) lista.unshift({ id: e.crop, nombre: e.crop, emoji: "🌱" });
      cajaCultivos.innerHTML = lista.map((c: any) =>
        `<button class="chip" type="button" data-crop="${c.id}" aria-pressed="${c.id === e.crop}">${c.emoji} ${esc(c.nombre)}</button>`).join("");
      if (!e.crop && lista.length) e = guardar({ crop: lista[0].id });
      cajaCultivos.querySelector(`[data-crop="${e.crop}"]`)?.setAttribute("aria-pressed", "true");
      calcular();
    } catch (err) {
      mostrarError(cajaCultivos, err, listarCultivos);
    }
  }

  function elegir(caja: HTMLElement, attr: string, cb: (v: string) => void) {
    caja.addEventListener("click", (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLButtonElement>(".chip");
      if (!b) return;
      caja.querySelectorAll(".chip").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      cb(b.dataset[attr]!);
    });
  }
  elegir(cajaCultivos, "crop", (v) => { e = guardar({ crop: v }); calcular(); });
  elegir(cajaDias, "dias", (v) => { e = guardar({ dias: Number(v) }); calcular(); });

  async function calcular() {
    if (!e.crop) return;
    cargando(plan, "Mirando el pronóstico de esta semana…");
    try {
      const d = await consultar("riego", { crop: e.crop, dias: e.dias || 30 });
      const nombre = d.cultivo.nombre.toLowerCase();
      const texto = d.veces === 0 ? `Esta semana no riegue su ${nombre}: la lluvia alcanza.`
        : `Esta semana riegue su ${nombre} ${d.veces === 1 ? "una vez" : d.veces === 2 ? "dos veces" : "tres veces"}: ${d.dias.filter((x: any) => x.regar).map((x: any) => x.dia).join(" y ")}. Cada vez, ${d.agua_por_vez}.`;
      plan.innerHTML = `
        <div class="tarjeta">
          <p class="etapa">${esc(d.cultivo.emoji)} ${esc(d.cultivo.nombre)} · ${esc(d.etapa)} (día ${num(Math.max(d.dia, 0))})</p>
          <p class="grande">${esc(texto)}</p>
          <ol class="semana">${d.dias.map((x: any) => `<li class="${x.regar ? "regar" : ""}">
            <span class="d">${esc(x.dia.slice(0, 3))}</span>
            <span class="i" aria-hidden="true">${x.regar ? "💧" : x.lluvia >= 2 ? "🌧️" : "☀️"}</span>
            <span class="l">${x.lluvia >= 0.5 ? `${num(x.lluvia, 0)} mm` : ""}</span>
            <span class="oculto">${x.regar ? "regar" : "no regar"}</span></li>`).join("")}</ol>
          <p class="peque">Lluvia prevista: ${num(d.lluvia_semana, 0)} mm · su cultivo usa unos ${num(d.gasto_semana, 0)} mm esta semana.</p>
          <a class="fuente" href="/datos">Pronóstico ECMWF · FAO-56</a>
        </div>
        <div class="pila acciones">
          <button class="btn btn-suave" type="button" id="oir">🔊 Escuchar</button>
          <a class="btn btn-borde" href="/sembrar">Ver el cultivo mes a mes</a>
        </div>
        <p class="peque">Antes de regar, meta un dedo en la tierra: si a dos dedos de hondo está húmeda, espere un día.</p>`;
      document.getElementById("oir")!.addEventListener("click", () => hablar(texto));
    } catch (err) {
      mostrarError(plan, err, calcular);
    }
  }
  listarCultivos();
</script>

<style>
  .grupo { border: 0; padding: 0; margin: 0 0 1rem; }
  .grupo legend { font-weight: 800; margin-bottom: 0.4rem; }
  :global(.envolver) { flex-wrap: wrap; }
  :global(.etapa) { margin: 0; font-weight: 800; color: var(--texto-2); }
  :global(.grande) { font: 800 1.25rem/1.3 var(--fuente-titulo); color: var(--verde); margin: 0.5rem 0 1rem; }
  :global(.semana) { list-style: none; padding: 0; margin: 0 0 0.8rem; display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }
  :global(.semana li) { display: grid; justify-items: center; gap: 2px; padding: 0.5rem 0.1rem; border-radius: 12px; background: var(--crema); font-weight: 800; }
  :global(.semana li.regar) { background: var(--azul-claro); outline: 2px solid var(--azul); }
  :global(.semana .d) { font-size: 0.8rem; text-transform: capitalize; }
  :global(.semana .i) { font-size: 1.4rem; }
  :global(.semana .l) { font-size: 0.7rem; color: var(--texto-2); min-height: 1em; }
  :global(.acciones) { margin: 1rem 0; }
  @media (min-width: 900px) { :global(.acciones) { grid-template-columns: 1fr 1fr; max-width: 640px; } }
</style>
