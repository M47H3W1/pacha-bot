---
import Base from "../layouts/Base.astro";
import "../styles/graficos.css";
---
<Base titulo="Qué sembrar" nav="sembrar">
  <p class="peque" id="lugar">Su parcela</p>
  <h1>¿Qué sembrar?</h1>
  <div class="raya"></div>
  <p class="sub">Elija el mes en que quiere sembrar.</p>
  <div class="chips meses" id="meses" role="group" aria-label="Mes de siembra"></div>
  <div id="recomendacion"></div>
  <section id="detalle" class="detalle" hidden aria-live="polite"></section>
</Base>

<script>
  import { guardar, leer, mesSiguiente, tieneParcela } from "../lib/estado";
  import { cargando, consultar, esc, hablar, MESES, mostrarError, num } from "../lib/api";
  import { deCada10, semaforo } from "../lib/graficos";

  let e = leer();
  if (!tieneParcela(e)) location.replace("/ubicacion");
  document.getElementById("lugar")!.textContent = e.nombre || "Su parcela";
  const caja = document.getElementById("recomendacion")!;
  const detalle = document.getElementById("detalle")!;
  let mes = e.mes || mesSiguiente();
  const VER: Record<string, [string, string]> = {
    si: ["p-si", "La lluvia alcanza"], cuidado: ["p-cuidado", "Regar a veces"], no: ["p-no", "Necesita riego"],
  };

  const chips = document.getElementById("meses")!;
  const hoy = new Date().getMonth();
  chips.innerHTML = Array.from({ length: 12 }, (_, i) => {
    const m = ((hoy + i) % 12) + 1;
    return `<button class="chip" type="button" data-mes="${m}" aria-pressed="${m === mes}">${MESES[m - 1]}</button>`;
  }).join("");
  const activo = chips.querySelector<HTMLElement>('[aria-pressed="true"]');
  if (activo) chips.scrollLeft = activo.offsetLeft - chips.clientWidth / 2 + activo.clientWidth / 2;
  chips.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>(".chip");
    if (!b) return;
    mes = Number(b.dataset.mes);
    chips.querySelectorAll(".chip").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    e = guardar({ mes });
    detalle.hidden = true;
    cargar();
  });

  function foto(c: any) {
    return c.foto ? `<img src="${c.foto}" alt="" loading="lazy">` : `<span class="emoji" aria-hidden="true">${c.emoji}</span>`;
  }

  async function cargar() {
    cargando(caja, "Probando cada cultivo con 23 años de datos de la NASA…");
    try {
      const d = await consultar("recomendacion", { mes });
      if (d.fuera_de_epoca) {
        caja.innerHTML = `<div class="tarjeta"><h3>${esc(d.mes_nombre)} no es época de siembra aquí</h3>
          <p>Mejor siembre en:</p><div class="chips">${d.meses_sugeridos.map((m: any) =>
            `<button class="chip" type="button" data-ir="${m.mes}">${esc(m.nombre)}</button>`).join("")}</div></div>`;
        caja.querySelectorAll<HTMLButtonElement>("[data-ir]").forEach((b) => b.addEventListener("click", () =>
          (chips.querySelector(`[data-mes="${b.dataset.ir}"]`) as HTMLButtonElement)?.click()));
        return;
      }
      const top = d.cultivos[0];
      const frase = `Para sembrar en ${d.mes_nombre}, lo mejor es ${top.nombre.toLowerCase()}: gana en ${top.gana_anios} de ${top.gana_de} años.`;
      caja.innerHTML = `
        <div class="titular"><p>${esc(frase)}</p><button class="btn btn-suave mini" type="button" id="oir">🔊 Escuchar</button></div>
        <ol class="cultivos">${d.cultivos.map((c: any, i: number) => `
          <li class="tarjeta cultivo">
            <div class="foto">${foto(c)}<span class="puesto">${i + 1}</span></div>
            <div class="info">
              <h2>${esc(c.nombre)}</h2>
              <span class="pastilla ${VER[c.veredicto][0]}">${VER[c.veredicto][1]}</span>
              <p class="gana">${c.gana_anios ? `<strong>${num(Math.max(1, Math.round((c.gana_anios / Math.max(c.gana_de, 1)) * 10)))} de cada 10 años</strong> es la mejor opción` : "<strong>Alternativa</strong> para variar la rotación"}</p>
              ${deCada10(c.gana_anios, c.gana_de)}
              <p class="peque">🌾 Cosecha en ${esc(c.cosecha)} · 💧 ${esc(c.riego_texto)}${c.fija_n ? " · 🌱 alimenta la tierra" : ""}</p>
              <button class="btn btn-borde mini ver" type="button" data-crop="${c.id}">Ver mes a mes y rotación</button>
            </div>
          </li>`).join("")}</ol>
        ${d.otros.length ? `<details class="otros"><summary>Otros cultivos para esta época (${d.otros.length})</summary>
          <div class="chips envolver">${d.otros.map((c: any) => `<button class="chip" type="button" data-crop="${c.id}">${c.emoji} ${esc(c.nombre)}</button>`).join("")}</div></details>` : ""}
        <p class="peque nota">"Gana" = sale primero cuando se prueba cada año de ${d.anios} por separado: agua que falta, riesgo de helada,
          ingreso y si alimenta el suelo. <a href="/datos">¿Cómo se calcula?</a></p>`;
      document.getElementById("oir")!.addEventListener("click", () => hablar(frase));
      caja.querySelectorAll<HTMLButtonElement>("[data-crop]").forEach((b) => b.addEventListener("click", () => verCultivo(b.dataset.crop!)));
    } catch (err) {
      mostrarError(caja, err, cargar);
    }
  }

  async function verCultivo(id: string, desplazar = true) {
    e = guardar({ crop: id, mes });
    detalle.hidden = false;
    cargando(detalle, "Calculando el agua mes a mes…");
    if (desplazar) detalle.scrollIntoView({ behavior: "smooth", block: "start" });
    try {
      const d = await consultar("cultivo", { crop: id, mes });
      const c = d.cultivo;
      const texto = d.veredicto === "si" ? `Buen momento para sembrar ${c.nombre.toLowerCase()} en ${d.mes_nombre}.`
        : d.veredicto === "cuidado" ? `Puede sembrar ${c.nombre.toLowerCase()} en ${d.mes_nombre}, pero riegue en ${d.mes_critico}.`
        : `Sin riego, mejor no siembre ${c.nombre.toLowerCase()} en ${d.mes_nombre}.`;
      detalle.innerHTML = `
        <div class="tarjeta">
          <div class="cab-detalle"><div class="mini-foto">${foto(c)}</div><div><h2>${esc(c.nombre)} en ${esc(d.mes_nombre)}</h2>
            <span class="pastilla ${VER[d.veredicto][0]}">${VER[d.veredicto][1]}</span></div></div>
          <p class="resumen-c">${esc(texto)} Le fue bien en <strong>${d.anios_bien} de ${d.anios} años</strong>. Cosecha en ${esc(d.cosecha)}.</p>
          ${!d.en_epoca && d.epoca ? `<p class="peque">📅 Ojo: la época de siembra aquí es ${esc(d.epoca)} (INIAP).</p>` : ""}
          <h3>Mes a mes</h3>
          ${semaforo(d.meses)}
          <p class="peque">Agua para todo el ciclo: <strong>${esc(d.riego_total_texto)}</strong>. Lluvia del ciclo: ${num(d.lluvia_min)} a ${num(d.lluvia_max)} mm según el año.</p>
          <a class="fuente" href="/datos">NASA POWER · FAO-56 · 23 años</a>
        </div>
        <div class="tarjeta">
          <h3>¿Qué sembrar después?</h3>
          <ol class="rotaciones">${d.rotaciones.map((r: any, i: number) => `<li><span class="op">Opción ${String.fromCharCode(65 + i)}</span>
            <div class="pasos">${r.pasos.map((p: any) => `<span class="paso">${p.emoji} ${esc(p.nombre)}<small>desde ${esc(p.desde)}</small></span>`).join('<span class="flecha" aria-hidden="true">→</span>')}</div>
            <p class="peque">${r.leguminosa ? `✅ ${esc(r.leguminosa)} alimenta la tierra.` : "✅ Cambiar de planta corta las plagas."}</p></li>`).join("")}</ol>
        </div>
        <div class="pila botones-detalle">
          <a class="btn btn-azul" href="/riego">💧 Cuánto regar esta semana</a>
          <button class="btn btn-suave" type="button" id="oir-c">🔊 Escuchar</button>
        </div>`;
      document.getElementById("oir-c")!.addEventListener("click", () => hablar(texto));
    } catch (err) {
      mostrarError(detalle, err, () => verCultivo(id));
    }
  }

  cargar();
  if (e.crop) verCultivo(e.crop, false);
</script>

<style>
  .meses { margin: 0.6rem 0 1.2rem; }
  :global(.mini) { width: auto; min-height: 44px; padding: 0.5rem 0.9rem; font-size: 0.95rem; }
  :global(.titular) { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; flex-wrap: wrap;
    background: var(--verde-claro); border-radius: 6px 18px 18px 18px; padding: 0.9rem 1rem; margin-bottom: 1rem; }
  :global(.titular p) { margin: 0; font-weight: 800; font-size: 1.1rem; color: var(--verde); flex: 1 1 240px; }
  :global(.cultivos) { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.85rem; }
  @media (min-width: 900px) { :global(.cultivos) { grid-template-columns: repeat(3, 1fr); } }
  :global(.cultivo) { display: grid; grid-template-columns: 112px 1fr; gap: 0.9rem; align-items: start; }
  :global(.cultivo .foto) { position: relative; aspect-ratio: 1; border-radius: 14px; overflow: hidden; background: var(--crema-2); display: grid; place-items: center; }
  :global(.cultivo .foto img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.emoji) { font-size: 3rem; }
  @media (min-width: 900px) { :global(.cultivo) { grid-template-columns: 1fr; } :global(.cultivo .foto) { aspect-ratio: 16/10; } }
  :global(.puesto) { position: absolute; top: 6px; left: 6px; width: 28px; height: 28px; border-radius: 50%; background: var(--verde); color: #fff;
    display: grid; place-items: center; font: 900 0.95rem var(--fuente-titulo); }
  :global(.cultivo h2) { font-size: 1.3rem; margin-bottom: 0.3rem; }
  :global(.gana) { margin: 0.5rem 0 0; }
  :global(.ver) { margin-top: 0.6rem; }
  :global(.otros) { margin: 1rem 0; } :global(.otros summary) { cursor: pointer; font-weight: 800; color: var(--azul); min-height: 44px; display: flex; align-items: center; }
  :global(.envolver) { flex-wrap: wrap; }
  :global(.nota) { margin: 1rem 0; }
  .detalle { display: grid; gap: 0.85rem; margin: 1.2rem 0 1.5rem; scroll-margin-top: 1rem; }
  :global(.cab-detalle) { display: flex; gap: 0.8rem; align-items: center; }
  :global(.mini-foto) { width: 64px; height: 64px; border-radius: 12px; overflow: hidden; flex: none; background: var(--crema-2); display: grid; place-items: center; }
  :global(.mini-foto img) { width: 100%; height: 100%; object-fit: cover; } :global(.mini-foto .emoji) { font-size: 2rem; }
  :global(.resumen-c) { font-size: 1.05rem; }
  :global(.rotaciones) { list-style: none; padding: 0; margin: 0.4rem 0 0; display: grid; gap: 0.8rem; }
  :global(.op) { font: 900 0.8rem var(--fuente-titulo); color: var(--naranja); text-transform: uppercase; letter-spacing: 0.05em; }
  :global(.pasos) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-top: 0.3rem; }
  :global(.paso) { display: grid; background: var(--crema); border-radius: 10px; padding: 0.4rem 0.6rem; font-weight: 800; }
  :global(.paso small) { font-weight: 600; color: var(--texto-2); font-size: 0.75rem; }
  :global(.flecha) { color: var(--texto-2); font-weight: 900; }
  @media (min-width: 900px) { :global(.detalle) { grid-template-columns: 1fr 1fr; } :global(.botones-detalle) { grid-column: 1 / -1; max-width: 420px; } }
</style>
