---
import Base from "../layouts/Base.astro";
---
<Base titulo="Ubicación" decoracion ancho="angosto">
  <h1 class="h1-ubi">¿Dónde está su parcela?</h1>
  <div class="raya"></div>

  <div class="globo">
    <span class="avatar" aria-hidden="true">
      <svg viewBox="0 0 120 70"><path d="M6 44 L44 10 L58 24 L68 16 L104 44" fill="none" stroke="#17533a" stroke-width="7" stroke-linejoin="round"/><path d="M10 50 C40 38 74 38 108 46 L106 52 C74 45 42 46 12 58 Z" fill="#3f8a4f"/><path d="M14 58 C44 48 76 48 104 54 L100 60 C72 55 46 56 20 66 Z" fill="#a7c13a"/><path d="M24 66 C50 58 74 58 96 62 L90 68 C70 64 52 65 34 70 Z" fill="#e2b33a"/></svg>
    </span>
    <p>¿Dónde está su parcela?</p>
  </div>

  <div class="pila">
    <button class="btn btn-azul" type="button" id="abrir-lista" aria-controls="lista" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
      Elegir parroquia
    </button>
    <button class="btn btn-borde" type="button" id="gps">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M21 3 3 10.5l7.5 3 3 7.5z"/></svg>
      Usar mi ubicación
    </button>
  </div>

  <section id="lista" class="lista tarjeta" hidden>
    <label for="buscar" class="oculto">Buscar parroquia</label>
    <input id="buscar" type="search" placeholder="Buscar parroquia o cantón" autocomplete="off" />
    <div id="resultados" class="resultados" role="listbox" aria-label="Parroquias"></div>
  </section>

  <p id="aviso" class="peque" role="status"></p>

  <button type="button" id="elegido" class="elegido" hidden>
    <svg class="pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
    <span><strong id="elegido-nombre"></strong><small id="elegido-detalle"></small></span>
    <svg class="check" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11"/><path d="m7 12.5 3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  <fieldset class="area">
    <legend>¿Qué tan grande es?</legend>
    <div class="chips" id="areas">
      <button class="chip" type="button" data-m2="500" aria-pressed="false">Huerto · 500 m²</button>
      <button class="chip" type="button" data-m2="2500" aria-pressed="true">¼ hectárea</button>
      <button class="chip" type="button" data-m2="5000" aria-pressed="false">½ hectárea</button>
      <button class="chip" type="button" data-m2="10000" aria-pressed="false">1 hectárea</button>
    </div>
  </fieldset>

  <button class="btn btn-primario continuar" type="button" id="continuar" disabled>Continuar</button>
</Base>

<script>
  import { EJEMPLO, guardar, leer, type Estado } from "../lib/estado";
  import { esc, obtener } from "../lib/api";

  type Parroquia = { nombre: string; canton: string; provincia: string; lat: number; lon: number; elev: number; demo: boolean };
  let parroquias: Parroquia[] = [];
  let eleccion: Estado | null = null;
  const $ = (id: string) => document.getElementById(id)!;
  const aviso = $("aviso");

  function marcar(e: Estado, detalle: string) {
    eleccion = e;
    $("elegido").hidden = false;
    $("elegido-nombre").textContent = e.nombre || "";
    $("elegido-detalle").textContent = detalle;
    ($("continuar") as HTMLButtonElement).disabled = false;
  }

  // Al entrar: la parcela guardada o el ejemplo de Calpi (como en el mock)
  const previo = leer();
  if (previo.lat && !previo.demo) marcar(previo, "Su parcela guardada");
  else marcar(EJEMPLO, "Escenario de ejemplo");
  const area = previo.area_m2 || 2500;
  document.querySelectorAll<HTMLButtonElement>("#areas .chip").forEach((b) => {
    b.setAttribute("aria-pressed", String(Number(b.dataset.m2) === area));
    b.addEventListener("click", () => {
      document.querySelectorAll("#areas .chip").forEach((x) => x.setAttribute("aria-pressed", "false"));
      b.setAttribute("aria-pressed", "true");
    });
  });

  function pintar(filtro = "") {
    const f = filtro.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();
    const norm = (s: string) => s.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();
    const lista = parroquias.filter((p) => !f || norm(`${p.nombre} ${p.canton} ${p.provincia}`).includes(f));
    const porProv = new Map<string, Parroquia[]>();
    lista.forEach((p) => porProv.set(p.provincia, [...(porProv.get(p.provincia) || []), p]));
    $("resultados").innerHTML = [...porProv].map(([prov, ps]) => `<h3>${esc(prov)}</h3>` + ps.map((p) =>
      `<button type="button" role="option" class="opcion" data-i="${parroquias.indexOf(p)}">
         <span>${esc(p.nombre)}</span><small>${esc(p.canton)} · ${p.elev.toLocaleString("es-EC")} m</small></button>`).join("")).join("")
      || '<p class="peque">No encontramos esa parroquia. Pruebe con "Usar mi ubicación".</p>';
  }

  $("abrir-lista").addEventListener("click", async () => {
    const lista = $("lista");
    lista.hidden = !lista.hidden;
    $("abrir-lista").setAttribute("aria-expanded", String(!lista.hidden));
    if (!lista.hidden) {
      if (!parroquias.length) {
        $("resultados").innerHTML = '<p class="peque">Cargando parroquias…</p>';
        try { parroquias = (await obtener("/api/parroquias")).parroquias; } catch {
          $("resultados").innerHTML = '<p class="peque">No se pudo cargar la lista. Revise su conexión.</p>'; return;
        }
      }
      pintar();
      ($("buscar") as HTMLInputElement).focus();
    }
  });
  $("buscar").addEventListener("input", (e) => pintar((e.target as HTMLInputElement).value));
  $("resultados").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".opcion");
    if (!b) return;
    const p = parroquias[Number(b.dataset.i)];
    marcar({ lat: p.lat, lon: p.lon, nombre: `${p.nombre}, ${p.provincia}`, provincia: p.provincia, demo: p.demo },
      `Parroquia de ${p.canton} · ${p.elev.toLocaleString("es-EC")} m`);
    $("lista").hidden = true;
    $("abrir-lista").setAttribute("aria-expanded", "false");
    $("continuar").focus();
  });

  $("gps").addEventListener("click", () => {
    if (!navigator.geolocation) { aviso.textContent = "Su teléfono no permite compartir la ubicación."; return; }
    aviso.textContent = "Buscando su ubicación…";
    navigator.geolocation.getCurrentPosition((pos) => {
      const { latitude: lat, longitude: lon } = pos.coords;
      aviso.textContent = "";
      marcar({ lat: +lat.toFixed(5), lon: +lon.toFixed(5), nombre: "Mi ubicación", demo: false },
        `${lat.toFixed(4)}, ${lon.toFixed(4)}`);
    }, () => { aviso.textContent = "No pudimos leer su ubicación. Elija su parroquia de la lista."; },
    { enableHighAccuracy: true, timeout: 15000 });
  });

  $("continuar").addEventListener("click", () => {
    if (!eleccion) return;
    const m2 = Number(document.querySelector<HTMLButtonElement>('#areas .chip[aria-pressed="true"]')?.dataset.m2 || 2500);
    guardar({ ...eleccion, area_m2: m2, crop: undefined });
    location.href = "/parcela";
  });
</script>

<style>
  .h1-ubi { font-size: clamp(1.8rem, 7vw, 2.2rem); }
  .globo { display: flex; align-items: center; gap: 0.7rem; margin: 0.4rem 0 1.4rem; }
  .avatar { width: 54px; height: 54px; border-radius: 50%; background: var(--tarjeta); border: 1px solid var(--borde);
    display: grid; place-items: center; flex: none; }
  .avatar svg { width: 36px; }
  .globo p { margin: 0; background: var(--crema-2); padding: 0.75rem 1rem; border-radius: 4px 16px 16px 16px; font-weight: 700; font-size: 1.05rem; }
  .lista { margin-top: 0.9rem; }
  .lista input { width: 100%; min-height: 50px; border-radius: 12px; border: 2px solid var(--borde); padding: 0 1rem;
    font: 600 1rem var(--fuente); background: var(--crema); color: var(--texto); }
  .resultados { max-height: 46vh; overflow-y: auto; margin-top: 0.6rem; }
  .resultados :global(h3) { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--texto-2); margin: 0.9rem 0 0.3rem; }
  .resultados :global(.opcion) { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; width: 100%;
    min-height: 48px; padding: 0.5rem 0.75rem; border: 0; border-radius: 10px; background: transparent; color: var(--texto);
    font: 700 1rem var(--fuente); text-align: left; cursor: pointer; }
  .resultados :global(.opcion:hover), .resultados :global(.opcion:focus-visible) { background: var(--verde-claro); }
  .resultados :global(.opcion small) { color: var(--texto-2); font-weight: 600; }
  .elegido { display: flex; align-items: center; gap: 0.9rem; width: 100%; margin: 1.3rem 0 0.4rem; padding: 1rem 1.1rem;
    background: var(--verde-claro); border: 0; border-radius: 6px 18px 18px 18px; text-align: left; color: var(--texto); cursor: default; }
  .elegido span { flex: 1; display: grid; }
  .elegido strong { font: 800 1.25rem var(--fuente-titulo); color: var(--verde); }
  .elegido small { color: var(--texto-2); font-size: 0.95rem; }
  .pin { width: 28px; fill: var(--verde); flex: none; }
  .check { width: 32px; fill: var(--verde); flex: none; }
  .area { border: 0; padding: 0; margin: 1rem 0 0; }
  .area legend { font-weight: 800; margin-bottom: 0.4rem; }
  .continuar { margin: 1.6rem 0 7rem; }
</style>
