---
import Base from "../layouts/Base.astro";

const nasa = [
  { n: "NASA POWER", d: "Temperatura, humedad, viento, radiación y lluvia diarias desde 2001 (reanálisis MERRA-2 y satélites CERES). Es la base de todos los cálculos.", u: "https://power.larc.nasa.gov/" },
  { n: "GPM IMERG", d: "Lluvia satelital a 0,1° (misión GPM). En nuestra validación sigue mejor el ritmo de los meses que MERRA-2 (r = 0,68 frente a 0,51).", u: "https://gpm.nasa.gov/data/imerg" },
  { n: "MODIS (Terra y Aqua)", d: "Verdor NDVI, temperatura de superficie nocturna y productividad. Acceso por la API de ORNL DAAC.", u: "https://modis.ornl.gov/" },
  { n: "SMAP", d: "Humedad del suelo superficial y en la zona de raíces.", u: "https://smap.jpl.nasa.gov/" },
  { n: "SRTM / NASADEM", d: "Altura y pendiente del terreno a 30 m.", u: "https://www.earthdata.nasa.gov/data/instruments/srtm" },
  { n: "NASA Earthdata (CMR)", d: "Catálogo con el que verificamos la cobertura de cada producto sobre la sierra.", u: "https://cmr.earthdata.nasa.gov/search/" },
];
const ecuador = [
  { n: "INAMHI", d: "Lluvia mensual de 947 estaciones (1960–2019). Con 85 de la sierra medimos y corregimos el error de los satélites.", u: "https://www.datosabiertos.gob.ec/" },
  { n: "MAG · Geopedológico 1:25.000", d: "Profundidad, textura, pH y fertilidad del suelo; zonificación agroecológica por cultivo.", u: "http://geoportal.agricultura.gob.ec/" },
  { n: "INIAP", d: "Variedades, duración del ciclo y épocas de siembra por provincia.", u: "https://repositorio.iniap.gob.ec/" },
];
const otras = [
  { n: "FAO-56 Penman-Monteith", d: "Método estándar para calcular cuánta agua usa cada cultivo.", u: "https://www.fao.org/4/x0490e/x0490e00.htm" },
  { n: "ECMWF (vía Open-Meteo)", d: "Corrección por altura y pronóstico de 7 días para el riego semanal.", u: "https://open-meteo.com/" },
  { n: "ISRIC SoilGrids", d: "Textura y carbono del suelo a 250 m (será reemplazado por el mapa del MAG).", u: "https://soilgrids.org/" },
  { n: "OpenStreetMap", d: "Ubicación de las parroquias (© colaboradores de OpenStreetMap, ODbL).", u: "https://www.openstreetmap.org/copyright" },
];
const pasos = [
  ["Satélites NASA", "POWER, IMERG y MODIS: 23 años de clima diario en su zona."],
  ["Corrección local", "Altura real del terreno y estaciones del INAMHI."],
  ["Agua del cultivo", "FAO-56: cuánto usa cada planta en cada etapa."],
  ["Balance del suelo", "Día a día: lluvia que entra, agua que la raíz usa, lo que falta."],
  ["Cada año por separado", "Se repite en los 23 años y se cuenta en cuántos gana cada cultivo."],
];
---
<Base titulo="Datos y ciencia" nav="datos">
  <h1>De dónde salen los datos</h1>
  <div class="raya"></div>
  <p class="sub">Pacha usa datos abiertos de la NASA y los contrasta con fuentes del Ecuador. Cada cifra de la app lleva una chapita con su fuente.</p>

  <section class="tarjeta bloque">
    <h2>Cómo se calcula</h2>
    <ol class="pasos">{pasos.map(([t, d], i) => <li><span class="n">{i + 1}</span><div><strong>{t}</strong><p>{d}</p></div></li>)}</ol>
  </section>

  <section class="tarjeta bloque validacion">
    <h2>Validación con estaciones reales</h2>
    <div class="cifras">
      <div><span class="cifra">85</span><p>estaciones del INAMHI en la sierra</p></div>
      <div><span class="cifra">40 % → 15 %</span><p>error en la lluvia anual al corregir el satélite con estaciones vecinas</p></div>
      <div><span class="cifra">7 de 10</span><p>así decimos la recomendación: en cuántos años gana cada cultivo</p></div>
    </div>
    <p class="peque">Detalle y scripts reproducibles en la carpeta <code>Documentacion-Investigacion</code> del repositorio.</p>
  </section>

  <section class="bloque">
    <h2>Datos de la NASA</h2>
    <ul class="fuentes rejilla">{nasa.map((f) => <li class="tarjeta"><h3>{f.n}</h3><p>{f.d}</p><a href={f.u} target="_blank" rel="noopener">Ver la fuente ↗</a></li>)}</ul>
  </section>
  <section class="bloque">
    <h2>Fuentes del Ecuador (contraste)</h2>
    <ul class="fuentes rejilla">{ecuador.map((f) => <li class="tarjeta"><h3>{f.n}</h3><p>{f.d}</p><a href={f.u} target="_blank" rel="noopener">Ver la fuente ↗</a></li>)}</ul>
  </section>
  <section class="bloque">
    <h2>Métodos y fuentes complementarias</h2>
    <ul class="fuentes rejilla">{otras.map((f) => <li class="tarjeta"><h3>{f.n}</h3><p>{f.d}</p><a href={f.u} target="_blank" rel="noopener">Ver la fuente ↗</a></li>)}</ul>
  </section>

  <section class="tarjeta bloque">
    <h2>Lo que no sabemos</h2>
    <ul>
      <li>Los satélites miden una zona de 10 a 50 km; su parcela puede ser más seca o más húmeda.</li>
      <li>Las heladas de valle son difíciles de ver desde el espacio.</li>
      <li>Pacha ayuda a pensar; la decisión es suya. Converse con su técnico del MAG o del INIAP.</li>
    </ul>
  </section>

  <section class="tarjeta bloque">
    <h2>Transparencia y créditos</h2>
    <p><strong>Uso de inteligencia artificial:</strong> el código y la documentación se escribieron con ayuda de Claude Code (Anthropic).
      Las preguntas libres del chat usan modelos abiertos por OpenRouter. Las ilustraciones de la app son SVG hechos a mano; no usamos imágenes
      generadas por IA ni el logo de la NASA.</p>
    <p><strong>Fotos de cultivos:</strong> Wikimedia Commons (CC BY-SA y CC0): Richard Webb, Schlaghecken Josef, Kolforn, Sanjay Acharya,
      Roger Culos, Daniela M., W.carter y D. Gordon E. Robertson.</p>
    <p class="peque">NASA Space Apps Challenge 2026 · Sangolquí · reto “Field Shift: Adapting Farms with NASA Data”.</p>
  </section>
</Base>

<style>
  .bloque { margin-top: 1rem; }
  section.bloque > h2 { margin-bottom: 0.6rem; }
  .pasos { list-style: none; padding: 0; margin: 0.6rem 0 0; display: grid; gap: 0.7rem; }
  .pasos li { display: grid; grid-template-columns: 36px 1fr; gap: 0.7rem; align-items: start; }
  .pasos p { margin: 0.1rem 0 0; color: var(--texto-2); }
  .n { width: 36px; height: 36px; border-radius: 50%; background: var(--verde); color: #fff; display: grid; place-items: center; font: 900 1rem var(--fuente-titulo); }
  @media (min-width: 900px) { .pasos { grid-template-columns: repeat(5, 1fr); } .pasos li { grid-template-columns: 1fr; } }
  .cifras { display: grid; gap: 0.8rem; margin: 0.6rem 0; }
  @media (min-width: 700px) { .cifras { grid-template-columns: repeat(3, 1fr); } }
  .cifras p { margin: 0.2rem 0 0; color: var(--texto-2); }
  .fuentes { list-style: none; padding: 0; margin: 0; }
  .fuentes p { color: var(--texto-2); margin: 0.3rem 0 0.6rem; }
  .fuentes a { font-weight: 800; }
  ul:not(.fuentes) li { margin: 0.3rem 0; }
</style>
