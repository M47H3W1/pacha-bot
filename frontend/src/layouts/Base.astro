---
import "../styles/global.css";
import Logo from "../components/Logo.astro";

interface Props {
  titulo: string;
  descripcion?: string;
  nav?: "parcela" | "sembrar" | "riego" | "preguntar" | "datos" | null;
  decoracion?: boolean;   // curvas de nivel y colinas del mock
  ancho?: "angosto" | "amplio";
}
const { titulo, descripcion = "Pacha: planifique su siembra y su riego en la sierra del Ecuador con datos de la NASA.",
  nav = null, decoracion = false, ancho = "amplio" } = Astro.props;
const enlaces = [
  { id: "parcela", href: "/parcela", t: "Parcela", icono: "M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z" },
  { id: "sembrar", href: "/sembrar", t: "Sembrar", icono: "M12 22V12m0 0C12 7 8 4 3 4c0 5 3 8 9 8zm0 0c0-4 3-7 9-7 0 5-4 7-9 7z" },
  { id: "riego", href: "/riego", t: "Riego", icono: "M12 2.7S5 10.4 5 15a7 7 0 0 0 14 0c0-4.6-7-12.3-7-12.3z" },
  { id: "preguntar", href: "/chat/", t: "Preguntar", icono: "M4 4h16v12H7l-3 3V4z" },
  { id: "datos", href: "/datos", t: "Datos", icono: "M4 20V10m6 10V4m6 16v-7m4 7H2" },
];
---
<!doctype html>
<html lang="es" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#17533a" />
  <meta name="description" content={descripcion} />
  <title>{titulo === "Pacha" ? "Pacha EC Bot" : `${titulo} · Pacha`}</title>
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/icono.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icono-192.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class:list={[{ "con-nav": nav }]}>
  <a class="saltar oculto" href="#contenido">Ir al contenido</a>
  {decoracion && (
    <svg class="curvas" viewBox="0 0 200 160" aria-hidden="true">
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <path d={`M${200 - i * 6} ${10 + i * 14} C ${150 - i * 10} ${30 + i * 12}, ${150 - i * 4} ${90 + i * 8}, ${80 - i * 8} ${150 + i * 2}`} />
      ))}
    </svg>
  )}
  <div class:list={["marco", ancho]}>
    <header class="cabecera">
      <Logo compacto={!!nav} />
      {nav && <nav class="nav-escritorio" aria-label="Secciones">
        {enlaces.map((l) => <a href={l.href} aria-current={l.id === nav ? "page" : undefined}>{l.t}</a>)}
      </nav>}
    </header>
    <main id="contenido">
      <slot />
    </main>
  </div>
  {decoracion && (
    <svg class="colinas" viewBox="0 0 400 90" preserveAspectRatio="none" aria-hidden="true">
      <g fill="none" stroke="var(--salvia)" stroke-width="1.4" opacity="0.7">
        <path d="M0 40 C60 20 110 50 170 34" /><path d="M0 50 C60 30 110 60 170 44" /><path d="M0 60 C60 40 110 70 170 54" />
      </g>
      <path d="M120 90 C180 40 260 30 330 60 C350 66 370 70 400 66 L400 90 Z" fill="var(--salvia)" opacity="0.75" />
      <path d="M300 90 C330 50 370 40 400 44 L400 90 Z" fill="var(--arena)" />
    </svg>
  )}
  {nav && (
    <nav class="nav-movil" aria-label="Secciones">
      {enlaces.map((l) => (
        <a href={l.href} aria-current={l.id === nav ? "page" : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.icono} /></svg>
          <span>{l.t}</span>
        </a>
      ))}
    </nav>
  )}
  <script>
    if ("serviceWorker" in navigator && location.hostname !== "localhost") {
      navigator.serviceWorker.register("/sw.js").catch(() => {});
    }
  </script>
</body>
</html>

<style>
  .marco { position: relative; z-index: 1; margin: 0 auto; padding: max(1rem, env(safe-area-inset-top)) 1rem 2rem; }
  .marco.angosto { max-width: 520px; }
  .marco.amplio { max-width: 1100px; }
  .cabecera { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.4rem 0 1rem; }
  .curvas { position: fixed; top: 0; right: 0; width: min(46vw, 260px); z-index: 0; pointer-events: none; }
  .curvas path { fill: none; stroke: var(--salvia); stroke-width: 1.3; opacity: 0.65; }
  .colinas { position: fixed; left: 0; right: 0; bottom: 0; width: 100%; height: 90px; z-index: 0; pointer-events: none; }
  body.con-nav { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }

  .nav-movil {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: grid; grid-template-columns: repeat(5, 1fr);
    background: var(--tarjeta); border-top: 1px solid var(--borde); padding: 0.35rem 0.25rem calc(0.35rem + env(safe-area-inset-bottom));
    box-shadow: 0 -4px 16px rgb(40 35 20 / 0.06);
  }
  .nav-movil a { display: grid; justify-items: center; gap: 0.15rem; padding: 0.35rem 0; min-height: 52px;
    color: var(--texto-2); text-decoration: none; font: 800 0.75rem var(--fuente-titulo); border-radius: 12px; }
  .nav-movil svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .nav-movil a[aria-current="page"] { color: var(--verde); background: var(--verde-claro); }
  .nav-escritorio { display: none; gap: 0.3rem; }
  .nav-escritorio a { padding: 0.55rem 0.9rem; border-radius: 999px; color: var(--texto-2); text-decoration: none; font: 800 0.98rem var(--fuente-titulo); }
  .nav-escritorio a[aria-current="page"] { background: var(--verde); color: #fff; }
  .saltar:focus { position: fixed; left: 1rem; top: 1rem; width: auto; height: auto; clip: auto; background: var(--tarjeta); padding: 0.6rem 1rem; z-index: 20; }

  @media (min-width: 900px) {
    .nav-movil { display: none; }
    .nav-escritorio { display: flex; }
    body.con-nav { padding-bottom: 0; }
    .marco { padding-top: 1.5rem; }
  }
</style>
